{minimum_otp_vsn, "24.0"}.

{cover_enabled, true}.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    {d, deprecated_21},
    {d, deprecated_22}
]}.

{erl_first_files, [
    "src/riak_api_pb_service.erl"   % behavior
]}.

{eunit_opts, [verbose]}.

{deps, [
    {riak_pb,
        {git, "https://github.com/basho/riak_pb.git",
            {branch, "develop-3.2"}}},
    {webmachine,
        {git, "https://github.com/basho/webmachine.git",
            {branch, "develop-3.2"}}},
    {riak_core,
        {git, "https://github.com/basho/riak_core.git",
            {branch, "develop-3.2"}}},
    {mochiweb,
        {git, "https://github.com/basho/mochiweb.git",
            {branch, "develop-3.2"}}}
]}.

{profiles, [
    {test, [
        {deps, [
            {meck,
                {git, "https://github.com/basho/meck.git",
                    {branch, "develop-3.2"}}}
        ]}
    ]},
    {gha, [{erl_opts, [{d, 'GITHUBEXCLUDE'}]}]}
]}.

{dialyzer, [{plt_apps, all_deps}]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used
]}.
